# Local development only. Use strong, unique credentials for a real deployment.
BIND_HOST=127.0.0.1
API_PORT=8000
DB_PORT=5433
TEST_DB_PORT=5434

POSTGRES_USER=money_transfer
POSTGRES_PASSWORD=money_transfer
POSTGRES_DB=money_transfer

TEST_POSTGRES_USER=money_transfer
TEST_POSTGRES_PASSWORD=money_transfer
TEST_POSTGRES_DB=money_transfer_test

# Keep credentials and ports in these URLs consistent with the values above.
# URL-encode special characters in usernames/passwords within URLs only.
# Host processes connect through published ports; containers use the db service.

# THESE ARE EXAMPLES. DO NOT USE THEM IN PRODUCTION. USE STRONG, UNIQUE CREDENTIALS.
DATABASE_URL=postgresql+psycopg://money_transfer:money_transfer@localhost:5433/money_transfer
TEST_DATABASE_URL=postgresql+psycopg://money_transfer:money_transfer@localhost:5434/money_transfer_test
DOCKER_DATABASE_URL=postgresql+psycopg://money_transfer:money_transfer@db:5432/money_transfer
